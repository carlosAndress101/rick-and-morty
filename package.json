{
  "name": "rick-and-morty",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Rick and Morty character browser built with React 19 and Vite 8.",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm lint && pnpm format:check && pnpm build"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^4.3.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "vite": "^8.2.2"
  }
}
